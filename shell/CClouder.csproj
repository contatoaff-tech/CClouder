<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>CClouder</AssemblyName>
    <RootNamespace>CClouder</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <!-- Versão em fonte única: lida de ../package.json (mesma usada pelo frontend). -->
    <PackageJsonContent>$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)..\package.json'))</PackageJsonContent>
    <Version>$([System.Text.RegularExpressions.Regex]::Match($(PackageJsonContent), '"version"\s*:\s*"([^"]+)"').Groups[1].Value)</Version>
    <Product>CClouder</Product>
    <Description>Limpador de sistema open source, leve e sem telemetria</Description>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CClouder.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.*" />
    <PackageReference Include="System.Management" Version="9.*" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\dist\**\*.*" Link="dist\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>

</Project>